<?xml version="1.0" encoding="utf-8"?>
<!-- MacroSnap brand small icon: white "M" monogram with nutrition-leaf
     accent. Small icons are alpha-only (white silhouette), so the mark
     mirrors the launcher/playstore logo for instant brand recognition. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFF">
    <!-- Stylized "M" letter (white silhouette) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,68L38,40L46,50L54,40L54,68L49,68L49,50L46,54L43,50L43,68Z"/>
    <!-- Leaf accent ring -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45"
        android:pathData="M62,42m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0"/>
    <!-- Leaf accent dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,38m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0"/>
</vector>
